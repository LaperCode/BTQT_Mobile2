<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#44FFEA00" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
    <!-- Bulb body -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFD54F" />
            <stroke android:width="2dp" android:color="#FFFFEA00" />
        </shape>
    </item>
    <!-- Inner bright core -->
    <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFCC" />
        </shape>
    </item>
</layer-list>
