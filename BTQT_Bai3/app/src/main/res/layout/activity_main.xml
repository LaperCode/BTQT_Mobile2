<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hacker_gradient">

    <com.dangngu.myapplication.MatrixRainView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/overlay_scanlines"
        android:alpha="0.52" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="NEON GESTURE HUB"
            android:textColor="@color/matrix_green"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:text="Realtime Sensor + IoT Command Console"
            android:textColor="@color/matrix_green_soft"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_hacker_soft"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/tabDashboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_active"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="DASHBOARD"
                android:textColor="@color/hacker_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabIot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/tab_idle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="IOT LINK"
                android:textColor="@color/matrix_green_soft"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTimeline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/tab_idle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="TIMELINE"
                android:textColor="@color/matrix_green_soft"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/sectionDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/cardRadar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel_hacker"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Gesture Radar (Realtime)"
                            android:textColor="@color/matrix_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="10dp">

                            <View
                                android:id="@+id/ringOne"
                                android:layout_width="170dp"
                                android:layout_height="170dp"
                                android:layout_gravity="center"
                                android:background="@drawable/ring_pulse" />

                            <View
                                android:id="@+id/ringTwo"
                                android:layout_width="170dp"
                                android:layout_height="170dp"
                                android:layout_gravity="center"
                                android:background="@drawable/ring_pulse" />

                            <View
                                android:id="@+id/ringThree"
                                android:layout_width="170dp"
                                android:layout_height="170dp"
                                android:layout_gravity="center"
                                android:background="@drawable/ring_pulse" />

                            <View
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:background="@drawable/dot_core" />

                            <TextView
                                android:id="@+id/tvGestureState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal|bottom"
                                android:layout_marginBottom="20dp"
                                android:background="@drawable/tab_idle"
                                android:fontFamily="monospace"
                                android:paddingStart="14dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="8dp"
                                android:textColor="@color/matrix_green_soft"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/panel_hacker"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Wave Hand => Phone Flashlight"
                            android:textColor="@color/matrix_green"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="Wave your hand in front of the screen to toggle"
                            android:textColor="@color/matrix_green_dim"
                            android:textSize="11sp" />

                        <!-- Flashlight status display -->
                        <FrameLayout
                            android:id="@+id/flashContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:background="@color/light_off_bg"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvFlashIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="monospace"
                                android:text="🔦"
                                android:textSize="56sp" />

                            <TextView
                                android:id="@+id/tvFlashOnOff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="80dp"
                                android:fontFamily="monospace"
                                android:text="OFF"
                                android:textColor="@color/matrix_green_dim"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <!-- Proximity wave indicator -->
                        <TextView
                            android:id="@+id/tvProximityState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:text="Proximity: waiting..."
                            android:textColor="@color/matrix_green_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvLightState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:textColor="@color/matrix_green_soft"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLightManual"
                            style="@style/Widget.MyApplication.HackerButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="FORCE FLASH ON" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardMedia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/panel_hacker"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Tilt => Volume | Rotate => Next/Prev"
                            android:textColor="@color/matrix_green"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Track name display -->
                        <TextView
                            android:id="@+id/tvMediaTrackName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:text="Neon Grid / Track 01"
                            android:textColor="@color/media_cyan"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Play status label -->
                        <TextView
                            android:id="@+id/tvMediaPlayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="▶ PLAYING"
                            android:textColor="@color/matrix_green"
                            android:textSize="12sp" />

                        <!-- Playback progress bar -->
                        <ProgressBar
                            android:id="@+id/mediaProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/media_cyan"
                            android:progressBackgroundTint="@color/panel_dark_alt" />

                        <!-- Media control row: Prev | Play/Pause | Next -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMediaPrev"
                                style="@style/Widget.MyApplication.HackerButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="⏮ PREV" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMediaPlayPause"
                                style="@style/Widget.MyApplication.HackerButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="⏸ PAUSE" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMediaNext"
                                style="@style/Widget.MyApplication.HackerButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="NEXT ⏭" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMediaState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/matrix_green_soft"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/volumeBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="12dp"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="@color/matrix_green"
                            android:progressBackgroundTint="@color/panel_dark_alt" />

                        <TextView
                            android:id="@+id/tvVolumeState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/matrix_green_soft"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardCreative"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/panel_hacker"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Creative: Face-down = Night Guard Macro"
                            android:textColor="@color/matrix_green"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCreativeState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/matrix_green_soft"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/sectionIot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/cardIotGateway"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel_hacker"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="IoT Gateway"
                            android:textColor="@color/matrix_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvConnectionState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/matrix_green_soft"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chipChannelWifi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/tab_active"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="WIFI"
                                android:textColor="@color/hacker_black"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/chipChannelBluetooth"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/tab_idle"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="BLUETOOTH"
                                android:textColor="@color/matrix_green_soft"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etWifiEndpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/edit_hacker"
                            android:fontFamily="monospace"
                            android:hint="WiFi Endpoint (ex: 192.168.1.100:8080/command)"
                            android:inputType="textUri"
                            android:padding="12dp"
                            android:textColor="@color/matrix_green_soft"
                            android:textColorHint="@color/matrix_green_dim" />

                        <EditText
                            android:id="@+id/etBluetoothAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/edit_hacker"
                            android:fontFamily="monospace"
                            android:hint="Bluetooth MAC (optional)"
                            android:inputType="text"
                            android:padding="12dp"
                            android:textColor="@color/matrix_green_soft"
                            android:textColorHint="@color/matrix_green_dim" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConnectBluetooth"
                                style="@style/Widget.MyApplication.HackerButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CONNECT BT" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDisconnectBluetooth"
                                style="@style/Widget.MyApplication.HackerButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="DISCONNECT" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardManualControl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/panel_hacker"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Manual Device Actions"
                            android:textColor="@color/matrix_green"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFanToggle"
                                style="@style/Widget.MyApplication.HackerButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="FAN: OFF" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTvToggle"
                                style="@style/Widget.MyApplication.HackerButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="TV: OFF" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendPing"
                            style="@style/Widget.MyApplication.HackerButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="SEND PING COMMAND" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/sectionTimeline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/cardTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_hacker"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Command Timeline"
                        android:textColor="@color/matrix_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCommandLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/timeline_box"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:minHeight="420dp"
                        android:padding="12dp"
                        android:textColor="@color/matrix_green_soft"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
